# /etc/caddy/env — variables lues par Caddy (drop-in systemd créé par deploy/install.sh). Après modification : sudo systemctl restart caddy
# Domaine (ou sous-domaine) dont l'enregistrement A/AAAA pointe sur le VPS → HTTPS Let's Encrypt automatique.
# Garder "localhost" tant que le DNS n'est pas prêt (certificat interne, test seulement). Ne jamais laisser vide (Caddy refuse de démarrer).
DOMAIN=localhost
# Authentification basique du tableau de bord ET des médias
DASH_USER=admin
# caddy hash-password --plaintext 'mot-de-passe'   → coller l'empreinte $2a$14$… telle quelle (pas d'expansion des $ ici)
DASH_HASH=
# Médias sans authentification (URL avec jeton) : laisser vide/false. À n'activer que si un outil externe (Higgsfield media_import_url)
# doit télécharger un fichier ; l'URL devient https://DOMAIN/public-media/MEDIA_TOKEN/08_ACCOUNTS/<compte>/posts/<fichier>
MEDIA_PUBLIC=false
MEDIA_TOKEN=
