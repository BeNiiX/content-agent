# Réveil toutes les 5 min ; l'heure réelle d'envoi est dans infra/config/project.json (daily_hour, daily_minute, daily_enabled),
# modifiable depuis le tableau de bord (onglet Agent) sans root ni réinstallation. La garde infra/src/publish/due.js
# (ExecCondition= du service) ne laisse passer qu'un départ par jour, dans les 20 min qui suivent l'heure prévue.
# Vérifier : systemctl list-timers content-* ; node infra/src/publish/due.js --status
[Unit]
Description=Content - envoi du soir (garde horaire toutes les 5 min, heure dans project.json)

[Timer]
OnCalendar=*-*-* *:00/5:00
# Pas de rattrapage : la garde refuse de toute façon un départ hors de la fenêtre de 20 min.
Persistent=false
AccuracySec=30s
Unit=content-daily-drafts.service

[Install]
WantedBy=timers.target
