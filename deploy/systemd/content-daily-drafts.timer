# 18:00 heure de Paris, été comme hiver : le suffixe de fuseau dans OnCalendar est géré par systemd (>= 243 ; Ubuntu 24.04 a la 255).
# Vérifier la prochaine exécution : systemctl list-timers content-* ; tester l'expression : systemd-analyze calendar "*-*-* 18:00:00 Europe/Paris"
# Changer l'heure : sudo systemctl edit content-daily-drafts.timer (drop-in) ou éditer ici puis `sudo bash deploy/install.sh`.
[Unit]
Description=Content - envoi du soir a 18:00 Europe/Paris

[Timer]
OnCalendar=*-*-* 18:00:00 Europe/Paris
# Pas de rattrapage : si le VPS était éteint à 18:00, on n'envoie pas les brouillons à 3 h du matin au redémarrage.
Persistent=false
AccuracySec=1min
Unit=content-daily-drafts.service

[Install]
WantedBy=timers.target
