# ---- Veille ----
# Chemin yt-dlp si pas dans le PATH
YTDLP_BIN=yt-dlp
# Navigateur pour les cookies (Instagram en a souvent besoin) : chrome | safari | firefox | vide
YTDLP_COOKIES_FROM_BROWSER=
# Pause entre deux appels yt-dlp (ms) — rester poli avec TikTok
YTDLP_DELAY_MS=1500
# Nb de vidéos récupérées par compte pour la médiane
AUTHOR_SAMPLE_SIZE=30

# ---- TikTok Marketing API (rapports + budgets) ----
# App développeur TikTok for Business avec scope Ads Management + Reporting
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ---- TikTok publication : aucune clé ici. Brouillons via le connecteur créateur Higgsfield (MCP), voir src/publish/README.md ----

# ---- Instagram Graph API (publication Reels) ----
# Compte pro/créateur lié à une Page Facebook ; token long (60 j) avec instagram_content_publish
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# ---- Supabase (lecture seule : banque de contenus de l'app, thèmes) — optionnel ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Envoi du soir (heure = daily_hour de config/project.json, scripts/daily-drafts.sh) : 1 brouillon TikTok par compte + message de consignes ----
# Canal : ntfy (app ntfy sur l'iPhone, abonnée au sujet NTFY_TOPIC ; une notification par compte) | telegram (bot + chat id)
#         | imessage (Messages.app du Mac — SANS notification : on est soi-même l'expéditeur) | stdout (journal seulement)
NOTIFY_CHANNEL=telegram
# Canal de secours si le principal n'est pas configuré / échoue (ntfy | imessage | vide)
NOTIFY_FALLBACK=ntfy
# Sujet ntfy : nom secret et imprononçable (quiconque le connaît peut lire / poster), ex. <slug>-brouillons-<aléatoire>
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Numéro ou e-mail iMessage du destinataire, ex. +33612345678
NOTIFY_IMESSAGE_TO=
# Telegram : 1) @BotFather → /newbot → coller le jeton ici  2) ouvrir le bot et envoyer /start  3) node src/publish/daily-notify.js --telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comptes concernés (vide = tous les comptes connectés non en pause) ; DAILY_DRY_RUN=1 = plan + message sans envoi
DAILY_ACCOUNTS=
DAILY_DRY_RUN=
# Modèle de la session Claude headless qui appelle le connecteur (claude-sonnet-5 ≈ 5× moins cher qu'opus ; test du 17/09 avec opus : 1,6 $ pour 1 brouillon)
DAILY_MODEL=claude-sonnet-5
